# Copy to .env.local for local testing. Never commit real values.
# In production, set these in Vercel: Project > Settings > Environment Variables.

# Admin sign-in. ADMIN_EMAIL can list several emails separated by commas.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional. A long random string; signing in again is needed if it changes.
SESSION_SECRET=

# Storage. Added automatically when Upstash Redis is connected through the
# Vercel Marketplace (either naming works).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# HubSpot private app. Scopes: tickets, conversations.read, crm.objects.owners.read
HUBSPOT_ACCESS_TOKEN=

# Claude API key used to score tickets.
ANTHROPIC_API_KEY=

# Slack app bot token. Scopes: users:read, users:read.email, im:write, files:write, chat:write
SLACK_BOT_TOKEN=
# Optional JSON map when an agent's Slack email differs from HubSpot, e.g. {"Anna H":"U0123ABC"}
SLACK_USER_MAP=

# Local only: run the admin flow with stand-ins for HubSpot, Claude and Slack.
QA_MOCK=
